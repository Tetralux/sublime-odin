%YAML 1.2
---
# http://www.sublimetext.com/docs/3/syntax.html
name: Odin
file_extensions:
  - odin
first_line_match: "-[*]-( Mode:)? Odin -[*]-"
scope: source.odin
variables:
  identifier: '[A-Za-z_][A-Za-z0-9_]*'
  loweridentifier: '\b[_]*[a-z][a-zA-Z0-9_]*\b'
  upperidentifier: '\b[_]*[A-Z][a-zA-Z0-9_]*\b'
  type_chars: '[[:alnum:]\s,._^<>\[\]-]'
  screaming_identifier: '\b[A-Z_](?![a-z])[A-Z_0-9]+\b'

contexts:
  main:
    - include: global

  global:
    - include: comments
    - include: operators
    - include: literals
    - include: keywords
    - include: basic-types
    - include: functions-and-declarations
    - include: types
    - include: variables
    - include: strings
    - include: string-escaped-char
    # - include: custom_styling
    - include: punctuation


  punctuation:
    - match: (\(|\)|\[|\]|\{|\}|;|,)
      scope: punctuation.odin

  custom_styling:
    - match: \b({{screaming_identifier}})\b
      captures:
        1: storage.constant.odin
    # - match: \b([A-Z][a-z0-9]+)([_A-Z][a-z0-9]*)*\b
    #   scope: support.variable.odin

  block-comment:
    - match: /\*
      scope: punctuation.definition.comment.odin
      push:
        - meta_scope: comment.block.odin
        - match: \*/
          scope: punctuation.definition.comment.odin
          pop: true
        - include: block-comment
        - include: todo

  todo:
    - match: '(TODO|NOTE|IMPORTANT|FIXME|XXX)'
      scope: keyword.odin

  comments:
    - include: block-comment
    - match: //
      scope: punctuation.definition.comment.odin
      push:
        - meta_scope: comment.line.double-slash.odin
        - match: \n
          pop: true
        - include: todo
    - match: "#!"
      scope: punctuation.definition.comment.odin
      push:
        - meta_scope: comment.line.double-slash.odin
        - match: \n
          pop: true

  literals:
    - include: strings
    - match: \b(nil|true|false)\b
      scope: constant.language.odin
    - match: '(?<![A-Za-z_0-9])(-|\+?)(\d(\d|_)*(.\d(\d|_)*)?)((e|E)(\+|-)?\d+)?[ijk]?\b'
      scope: constant.numeric.odin
    - match: '\b((0b(0|1|_)+)|(0o(\d|_)+)|(0d(\d|_)+)|(0[xXh](\h|_)+))[i]?\b'
      scope: constant.numeric.odin
    - match: '(?<![A-Za-z_0-9\.])\.{{identifier}}(?=!\()'
      scope: constant.variable.odin
    - match: '---'
      scope: constant.language.odin

  keywords:
    - match: '\b(_)\b'
      scope: keyword.control.discard.odin
    - match: \b(import|foreign|package)\b
      scope: keyword.other.odin
    - match: \b(if|else|when|where|for|in|not_in|defer|switch|return|do|try|or_else|or_return|or_break|or_continue)\b
      scope: keyword.control.odin
    - match: \b(fallthrough|break|continue|case|dynamic)\b
      scope: keyword.control.odin
    - match: \b(using)\b
      scope: keyword.control.odin
    - match: \b(asm)\b
      scope: keyword.control.odin
    - match: \b(distinct|opaque)\b
      scope: keyword.type.odin
    - match: \b(context)\b
      scope: keyword.other.odin
    - match: \b(struct|enum|union|map|bit_set|typeid)\b
      scope: keyword.type.odin
    - match: \b(cast|transmute|auto_cast)\b
      scope: keyword.other.odin
    - match: ([@#]({{identifier}}))
      scope: keyword.other.attribute.odin
    - match: '@(\()'
      scope: keyword.other.attribute.odin
      push:
        - match: '\)'
          pop: true
          scope: keyword.other.tag.odin
        - include: literals
        - include: operators
    - match: '({{identifier}})(\.)({{identifier}})(?:(\.)({{identifier}}))*'
      captures:
        1: variable.odin
        2: keyword.operator.odin
        3: variable.odin
        4: keyword.operator.odin
        5: variable.odin
    - match: '(\)|\]|\})(\.)({{identifier}})'
      captures:
        1: source.odin
        3: variable.odin
    - match: '(\s+)(\.{{identifier}})'
      captures:
        2: constant.numeric.arc

  operators:
    - match: \.\.\<
      scope: keyword.operator.odin
    - match: \.\.\=
      scope: keyword.operator.odin
    - match: \.\.?
      scope: keyword.operator.odin
    - match: (->|\!=|==|::|:=?|\?|=|\*=?|/=?|\+=?|-=?|<<=?|>>=?|>=?|<=?|%=?|\^=?|\|=?|\|\|=?|&=?|&&=?|!=?|~=?|!)
      scope: keyword.operator.odin

  functions-and-declarations:
    - match: '\b({{identifier}})\s*(::)\s*(proc)'
      captures:
        1: meta.function.odin entity.name.function.odin
        2: storage.modifier.odin
        3: keyword.control.odin
    - match: '\b({{identifier}})\s*(::)\s*(#force_inline|#force_no_inline)\s+(proc)'
      captures:
        1: meta.function.odin entity.name.function.odin
        2: keyword.operator.odin
        3: keyword.control.odin
        4: keyword.control.odin
    - match: \b(size_of|align_of|offset_of|type_of|type_info_of|typeid_of)\b\s*(\()
      captures:
        1: keyword.function.odin
        2: punctuation.odin
    - match: (proc)\s*(\()
      captures:
        1: keyword.control.odin
        2: punctuation.odin
    - match: \b(?<!\.)(len|cap|make|delete|delete_key|new(?:_clone)?|free(?:_all)?|clear|reserve|resize|append|append_string|append_nothing|inject_at|assign_at|map_insert|min|max|clamp|raw_data|copy|pop|pop_safe|pop_front|pop_front_safe|(?:un)?ordered_remove|remove_range)(\()
      captures:
        1: support.function.odin
        2: punctuation.odin
    - match: \b(assert|panic|unimplemented|unreachable|card|incl|excl|default_hash(?:_string)?|source_code_location_hash|init_global_temporary_allocator)\s*(\()
      captures:
        1: support.function.odin
        2: punctuation.odin
    - match: ({{identifier}})\s*(\!)?\s*(\()
      captures:
        1: meta.function-call.odin variable.function.odin
        3: punctuation.odin
    - match: '\b({{identifier}})\s*(::)\s*(struct|union|enum|bit_set)'
      captures:
        1: meta.type.odin entity.name.type.odin
        2: keyword.operator.odin
        3: storage.type.odin
    - match: '\b({{identifier}})\s*(::)\s*([#]\s*type)'
      captures:
        1: meta.type.odin entity.name.type.odin
        2: keyword.operator.odin
        3: keyword.other.tag.odin
    - match: '\b({{identifier}})\s*(::)\s*'
      captures:
        1: meta.constant.odin, support.constant.odin entity.name.type.odin
        2: keyword.operator.odin
    - match: '(\(|\)|\[|\]|\{|\})'
      scope: punctuation.odin
    # - match: '\b({{identifier}})\s*((,)\s*({{identifier}}))*\s*(?:(:=?)|(\s+in))'
    #   captures:
    #     1: variable.parameter.odin
    #     3: punctuation.odin
    #     4: variable.parameter.odin
    #     5: keyword.operator.odin
    #     6: keyword.control.odin

  types:
    - match: '\b(struct|enum|union|bit_set)\b(?:(\{)(\}))?'
      captures:
        1: storage.type.odin
        2: meta.block.odin, punctuation.definition.block.begin.odin
        3: meta.block.odin, punctuation.definition.block.end.odin
    - match: (\[)(\d*)(\])(?=[[:alpha:]_])
      scope: meta.brackets.odin
      captures:
        1: punctuation.definition.brackets.begin.odin
        2: constant.numeric.odin
        3: punctuation.definition.brackets.end.odin
    - match: '\$\s*({{identifier}})'
      scope: storage.type.odin
    - match: '{{upperidentifier}}'
      scope: support.type.odin

  basic-types:
    - match: '\b(i8|i16|i32|i64|i128|int)\b'
      scope: storage.type.odin
    - match: '\b(u8|u16|u32|u64|u128|uint|uintptr)\b'
      scope: storage.type.odin
    - match: '\b((f16)|((f32|f64)(le|be)?))\b'
      scope: storage.type.odin
    - match: '\b(complex|complex32|complex64|complex128)\b'
      scope: storage.type.odin
    - match: '\b(quaternion|quaternion64|quaternion128|quaternion256)\b'
      scope: storage.type.odin
    - match: '\b(matrix)\b'
      scope: storage.type.odin
    - match: '\b(bool|b8|b16|b32|b64)\b'
      scope: storage.type.odin
    - match: '\b(string|cstring|rune)\b'
      scope: storage.type.odin
    - match: '\b(rawptr)\b'
      scope: storage.type.odin
    - match: '\b(any|typeid)\b'
      scope: storage.type.odin
    - match: '\b(byte)\b'
      scope: storage.type.odin

    - match: '\b(u16le|u32le|u64le|u128le|i16le|i32le|i64le|i128le)\b'
      scope: storage.type.odin
    - match: '\b(u16be|u32be|u64be|u128be|i16be|i32be|i64be|i128be)\b'
      scope: storage.type.odin

  strings:
    - match: '"'
      scope: punctuation.definition.string.begin.odin
      push:
        - meta_scope: string.quoted.double.odin
        - match: '"'
          scope: punctuation.definition.string.end.odin
          pop: true
        - include: string-escaped-char
    - match: "`"
      scope: punctuation.definition.string.begin.odin
      push:
        - meta_scope: string.quoted.raw.odin
        - match: "`"
          scope: punctuation.definition.string.end.odin
          pop: true
    - match: "'"
      scope: punctuation.definition.string.begin.odin
      push:
        - meta_scope: string.quoted.raw.odin
        - match: "'"
          scope: punctuation.definition.string.end.odin
          pop: true
        - include: string-escaped-char

  string-escaped-char:
    - match: '\\(\\|[abefnrutv''"]|x\h{2}|u\h{4}|U\h{8}|[0-7]{3})'
      scope: constant.character.escape.odin
    - match: \\.
      scope: invalid.illegal.unknown-escape.odin
    - match: '%(\d*[vsqxid])'
      scope: constant.character.escape.format.odin

  variables:
    - match: '(\.)({{identifier}})(\()'
      captures:
        1: keyword.operator.odin
        2: variable.function.odin
        3: punctuation.odin
    - match: '(\.)?({{identifier}})'
      captures:
        1: keyword.operator.odin
        2: variable.odin
    # - match: '{{loweridentifier}}'
    #   scope: variable.name.odin
